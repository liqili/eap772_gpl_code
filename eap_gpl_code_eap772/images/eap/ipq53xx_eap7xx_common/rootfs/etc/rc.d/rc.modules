#!/bin/sh

echo "This board use 5.4.213"
kver=5.4.213
kernel_path=/lib/modules/${kver}/kernel
kernel_net_path=/lib/modules/${kver}/net

echo ${kernel_path} > /tmp/kernel_module_path

#qca cnss2
insmod ${kernel_path}/ipq_cnss2.ko bdf_integrated=0x12

/sbin/cnssdaemon -s &

insmod ${kernel_path}/slhc.ko
insmod ${kernel_path}/ppp_generic.ko
insmod ${kernel_path}/pppox.ko
insmod ${kernel_path}/pppoe.ko
# insmod ${kernel_path}/kernel/mtdoops.ko mtddev=oops record_size=16384
insmod ${kernel_path}/cfg80211.ko
insmod ${kernel_path}/qca-ssdk.ko
insmod ${kernel_path}/nf_defrag_ipv6.ko
insmod ${kernel_path}/nat46.ko
insmod ${kernel_path}/qca-nss-ppe.ko
insmod ${kernel_path}/qca-nss-dp.ko
insmod ${kernel_path}/qca-nss-ppe-vp.ko

insmod ${kernel_path}/emesh-sp.ko
insmod ${kernel_path}/bonding.ko
#qca-ovsmgr
insmod ${kernel_path}/qca-nss-ppe-vlan.ko
insmod ${kernel_path}/qca-nss-ppe-bridge-mgr.ko
insmod ${kernel_path}/qca-nss-ppe-ds.ko
insmod ${kernel_path}/qca-nss-ppe-lag.ko
insmod ${kernel_path}/qca-nss-ppe-pppoe-mgr.ko
insmod ${kernel_path}/qca-nss-ppe-rule.ko

insmod ${kernel_path}/qca-nss-eip.ko

# netfilter
insmod ${kernel_path}/x_tables.ko
insmod ${kernel_path}/xt_tcpudp.ko
insmod ${kernel_path}/xt_mark.ko
insmod ${kernel_path}/xt_TCPMSS.ko
insmod ${kernel_path}/xt_comment.ko
#insmod ${kernel_path}/xt_iprange.ko
insmod ${kernel_path}/xt_mac.ko
insmod ${kernel_path}/xt_multiport.ko
insmod ${kernel_path}/xt_string.ko
insmod ${kernel_path}/xt_time.ko
#insmod ${kernel_path}/ipt_multiurl.ko

insmod ${kernel_path}/nf_defrag_ipv4.ko
#insmod ${kernel_path}/nf_defrag_ipv6.ko
insmod ${kernel_path}/libcrc32c.ko
#insmod ${kernel_path}/pptp.ko
insmod ${kernel_path}/nf_conntrack.ko
#insmod ${kernel_path}/nf_conntrack_proto_gre.ko
insmod ${kernel_path}/nf_conntrack_h323.ko

insmod ${kernel_path}/xt_conntrack.ko
insmod ${kernel_path}/xt_state.ko
insmod ${kernel_path}/xt_physdev.ko

# kernel dir: net/ipv4/netfilter/

#insmod ${kernel_path}/nf_conntrack_ipv4.ko

insmod ${kernel_path}/nf_nat.ko
#insmod ${kernel_path}/nf_nat_proto_gre.ko

#insmod ${kernel_path}/nf_nat_ipv4.ko
#insmod ${kernel_path}/nf_nat_masquerade_ipv4.ko
#insmod ${kernel_path}/nf_nat_redirect.ko
insmod ${kernel_path}/nf_reject_ipv4.ko
insmod ${kernel_path}/ip_tables.ko
insmod ${kernel_path}/iptable_filter.ko
insmod ${kernel_path}/iptable_nat.ko
#insmod ${kernel_path}/iptable_raw.ko
#insmod ${kernel_path}/ipt_MASQUERADE.ko
insmod ${kernel_path}/xt_REDIRECT.ko
insmod ${kernel_path}/ipt_REJECT.ko
#insmod ${kernel_path}/ipt_TRIGGER.ko

# kernel dir: net/bridge/netfilter

insmod ${kernel_path}/ebt_ip.ko
insmod ${kernel_path}/ebt_limit.ko
insmod ${kernel_path}/ebt_log.ko
insmod ${kernel_path}/ebtables.ko
insmod ${kernel_path}/ebtable_filter.ko

insmod ${kernel_path}/usb-common.ko
insmod ${kernel_path}/udc-core.ko
insmod ${kernel_path}/libcomposite.ko
insmod ${kernel_path}/usb_f_diag.ko
insmod ${kernel_path}/crc-ccitt.ko
insmod ${kernel_path}/diagchar.ko

productCfgFile=$(head -n 1 /tmp/cfgFilePath)
max_Radio_Num=`cat "$productCfgFile/radio_config.json" | grep maxRadioSupp | cut -d ":" -f2 | tr -d ' ' | tr -d ','`
if [ "$max_Radio_Num" -eq 1 ]; then
maxRadioNum=1
elif [ "$max_Radio_Num" -eq 2 ]; then
maxRadioNum=2
elif [ "$max_Radio_Num" -eq 3 ]; then
maxRadioNum=3
else
maxRadioNum=0xFFF
fi

#tls_tuple
insmod ${kernel_path}/tls_tuple_lib.ko 

#portal
insmod ${kernel_path}/portal.ko l_maxRadioNum=$maxRadioNum

#vlan_manage
insmod ${kernel_path}/vlan_manage.ko l_maxRadioNum=$maxRadioNum

#tp_domain
insmod ${kernel_path}/tp_domain.ko lan_ip=0xc0a80101 lan_domain=tplinkeap.net

#dhcp capture
insmod ${kernel_path}/dhcp_capture.ko l_maxRadioNum=$maxRadioNum

productCfgFile=$(head -n 1 /tmp/cfgFilePath)

nvrammanager -r /tmp/default-config -p config-info
factory_mode=`cat /tmp/default-config | grep factory | cut -d ":" -f2 | tr -d ' '`
if [ "$factory_mode" -eq 1 ]; then
factoryMode=1
else
factoryMode=0
fi

#gpio
#insmod ${kernel_path}/gpio.ko  l_cfgFile=${productCfgFile}/gpio.conf l_factoryMode=$factoryMode l_powerMode=$powerMode
#rm /tmp/default-config
insmod ${kernel_path}/gpio.ko  l_cfgFile=${productCfgFile}/gpio.conf l_factoryMode=$factoryMode
rm /tmp/default-config

#mesh
insmod ${kernel_path}/mesh.ko

#rate limit
insmod ${kernel_path}/rate_limit.ko l_maxRadioNum=$maxRadioNum

#bootconfig
insmod ${kernel_path}/bootconfig.ko

#qca_mcs
insmod ${kernel_net_path}/qca-mcs.ko

#qca sfe
insmod ${kernel_path}/qca-nss-sfe.ko

#qca ecm
insmod ${kernel_path}/ecm.ko front_end_selection=0

#tp_mdns
insmod ${kernel_path}/tp_mdns.ko l_maxRadioNum=$maxRadioNum
