	cd /home/tplink/share/EAP772_gpl/PLATFORM/apps/rtty && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
