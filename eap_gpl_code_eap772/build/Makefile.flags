##################################### bandwidth power limit define #############################################
ifeq ($(strip ${CONFIG_BW_PWR_LIMIT}), y)
SMB_PRIV_COMMON_CFLAGS += -DBW_PWR_LIMIT
endif

##################################### caldata_cfg define #############################################
ifeq ($(strip ${CONFIG_CALDATA_CFG_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_CALDATA_CFG_SUPPORT
endif

################################## multiple radius severs define ###################################
ifeq ($(strip ${CONFIG_MULTIPLE_RADIUS_SERVERS_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_MULTIPLE_RADIUS_SERVERS_SUPPORT
endif

##################################### wids_wips define #############################################
ifeq ($(strip ${CONFIG_WIDS_WIPS_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_WIDS_WIPS_SUPPORT
endif

##################################### lock to AP define #############################################
ifeq ($(strip ${CONFIG_LOCKTOAP_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_LOCKTOAP_SUPPORT
ifdef CONFIG_LOCKTOAP_LIST_MAX_SIZE
SMB_PRIV_COMMON_CFLAGS += -DLOCKTOAP_LIST_MAX_SIZE=$(CONFIG_LOCKTOAP_LIST_MAX_SIZE)
endif
endif

################################## multicast management define ###################################
ifeq ($(strip ${CONFIG_MULTICAST_MNG_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_MULTICAST_MNG_SUPPORT
endif

################################## multicast convert define ###################################
ifeq ($(strip ${CONFIG_MULTICAST_CONV_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_MULTICAST_CONV_SUPPORT
endif

################################## multiPort define && dot1x define###################################
ifeq ($(strip ${CONFIG_MULTIPORT_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_MULTIPORT_SUPPORT
TP_SDK_CFLAGS += -DCONFIG_TP_MULTIPORT_SUPPORT
ifeq ($(strip ${CONFIG_DOT1X_AUTH_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_DOT1X_AUTH_SUPPORT
endif
endif

####################################### gre define ########################################
ifeq ($(strip ${CONFIG_GRE_SUPPORT}), y)
SMB_PRIV_COMMON_CFLAGS += -DCONFIG_GRE_SUPPORT
endif

##################################### T40 SUT define #############################################
ifeq ($(strip ${CONFIG_SUPPORT_T40_SUT}), y)
SMB_PRIV_COMMON_CFLAGS += -DSUPPORT_T40_SUT
endif
