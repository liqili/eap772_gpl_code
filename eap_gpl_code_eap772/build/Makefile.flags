# QCA方案的SDK版本计算规则:x.y.z的SPF形式转换为16进制的形式进行大小比较
# x表示SPF的版本，若SDK没有SPF的概念则改为0,y、z分别表示SPF的次版本、小版本，若无则写为0
# 平台当前的一些驱动VERSION转换情况:
# N300:	9.5.3.16 => 0.9.5(0x905)	10.2.0082.4 => 0.10.2(0xA02)
# AC:	10.4.2.3 => 2.0.0(0x20000)	10.4.x => 5.0.2(0x50002)
# AX:	SPF10.0 => 10.0.0(0xA0000)	SPF11.1 => 11.1.0(0xB0100)	SPF11.3 => 11.3.0(0xB0300)	SPF11.4 => 11.4.0(0xB0400)
ifneq ($(strip ${CONFIG_TP_QCA_SDK_VERSION_CODE}),)
SMB_PRIV_COMMON_CFLAGS += -DTP_QCA_SDK_VERSION_CODE=${CONFIG_TP_QCA_SDK_VERSION_CODE}
endif

